# Environment variables (copy to .env and fill in)
# Never commit .env — it is gitignored.

# Template update checker upstream (optional override)
# TEMPLATE_UPSTREAM=edwardlthompson/agent-project-bootstrap

# Icon pack renderer (CI default is dry-run; never require GPU in Actions)
RENDER_BACKEND=dry-run
# BLENDER_BIN=/absolute/path/to/blender
CYCLES_DEVICE=OPTIX
# HOVER_ICONS_GPU=1

# Project-specific variables (add below)
# API_BASE_URL=http://localhost:3000
# LOG_LEVEL=info

# Android upload keystore (file stays outside git; see docs/ANDROID_SIGNING.md)
# GOLDENPATH_UPLOAD_STORE_FILE=/absolute/path/to/upload.jks
# GOLDENPATH_UPLOAD_STORE_PASSWORD=
# GOLDENPATH_UPLOAD_KEY_ALIAS=upload
# GOLDENPATH_UPLOAD_KEY_PASSWORD=
